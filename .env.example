# Copiá este archivo a .env (en la raíz del proyecto, junto a docker-compose.yml)
# y completá los valores. El .env está en .gitignore, no se versiona.
#
# Estas variables las lee docker-compose.yml. Si no existe el .env,
# se usan los defaults de desarrollo local (inseguros para producción).

# Contraseña de la base de datos Postgres.
# En el VPS usá una contraseña larga y aleatoria, por ejemplo generada con:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Clave con la que se firman los tokens de sesión del panel admin.
# También debe ser larga y aleatoria (openssl rand -hex 32).
# Ojo: si la cambiás más adelante, se cierran las sesiones admin activas.
JWT_SECRET=

# Puerto público donde se sirve la web.
# - Desarrollo local: dejalo vacío o poné 3000.
# - VPS: si el 80 ya está ocupado por otro sitio (nginx nativo, etc.), usá un
#   puerto libre como 8080. La web va a quedar accesible en http://IP:8080.
FRONTEND_PORT=8080

# Dirección en la que Docker publica el puerto de arriba.
# - Desarrollo local: dejalo vacío (queda 0.0.0.0, accesible desde tu red).
# - VPS CON dominio: poné 127.0.0.1 → el puerto deja de ser alcanzable desde
#   internet y solo lo usa el nginx del sistema para hacerle proxy desde 80/443.
#   Ojo: cerrar este puerto con UFW NO funciona. Docker inserta sus reglas de
#   iptables en la cadena DOCKER, que se evalúa antes que las de UFW, así que un
#   puerto publicado por Docker queda abierto igual. Atarlo a 127.0.0.1 es la
#   única forma real de cerrarlo.
FRONTEND_BIND=127.0.0.1

# Orígenes permitidos para pedidos CORS a la API, separados por coma y con el
# esquema incluido. Ejemplo:
#   CORS_ORIGIN=https://manhattannegociosinmobiliarios.com.ar,https://www.manhattannegociosinmobiliarios.com.ar
# Si queda vacío, el backend acepta cualquier origen ('*'), que es lo cómodo en
# desarrollo local pero NO lo que querés en el VPS.
# Nota: la web en sí no depende de esto (el nginx del frontend hace proxy de
# /api, así que todo es mismo origen). Solo limita a clientes externos.
CORS_ORIGIN=

# Puerto del host mapeado al backend (127.0.0.1), solo para debug local.
# No lo usa el sitio en sí (el frontend le habla al backend por la red interna
# de Docker). Cambialo solo si el 4000 ya está ocupado en el VPS por otra app.
BACKEND_PORT=4000

# Credenciales de la cuenta de Cloudinary donde se suben las fotos de
# propiedades y del contenido del sitio. Se sacan del dashboard de Cloudinary
# (Settings → Access Keys, o directamente en la home del dashboard).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
