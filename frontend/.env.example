# Copiá este archivo a .env y completá los valores reales.
# (.env está en .gitignore, no se versiona)

# Teléfonos de contacto directo (bloque "¿Necesita una respuesta inmediata?" en /contacto)
# Las variables de Vite deben empezar con VITE_ y se incrustan al build:
# si cambiás un número hay que rebuildear el frontend (docker compose up -d --build frontend).
#
# Formato tel: con + y código de país, sin espacios ni guiones. Ej: +5491160479977
# Formato WhatsApp (wa.me): solo dígitos, código de país incluido. Ej: 5491160479977

VITE_PHONE_SHAUL_TEL=
VITE_PHONE_SHAUL_WA=
VITE_PHONE_SALOMON_WA=

# Número que recibe las postulaciones de trabajo y las solicitudes para abrir una
# sucursal (página /postulaciones). Es opcional: si se deja vacío, esos mensajes van
# al mismo número que las tasaciones (VITE_PHONE_SHAUL_WA). Completalo solo si querés
# derivar las postulaciones a otro teléfono, por ejemplo el de RRHH.
VITE_PHONE_RRHH_WA=
