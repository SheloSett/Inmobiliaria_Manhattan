generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Property {
  id            Int           @id @default(autoincrement())
  title         String
  description   String
  price         Float
  currency      String        @default("USD")
  // Expensas (11/08/2026): monto opcional del gasto mensual de expensas y su moneda
  // (puede ser distinta a la del precio: el precio suele ir en USD y las expensas en ARS).
  expenses         Float?
  expensesCurrency String  @default("ARS")
  // operation y type dejaron de ser enums fijos: ahora son strings que referencian
  // (por su `value`) a los catálogos OperationType / PropertyTypeOption, gestionables
  // desde el admin (Ajustes → Catálogos). Se guardan como texto para poder agregar
  // tipos nuevos sin migrar la BD. Los valores existentes (SALE/RENT/APARTMENT...) se
  // conservan; el seed crea los catálogos con esos mismos `value`.
  operation     String
  type          String
  status        PropertyStatus @default(AVAILABLE)
  bedrooms      Int?
  bathrooms     Int?
  area          Float?
  garage        Boolean       @default(false)
  // hasKey ("con llave"): indica que la inmobiliaria tiene la llave para mostrar la
  // propiedad. Agregado el 27/07/2026 (migración property_has_key).
  hasKey        Boolean       @default(false)
  address       String
  city          String
  neighborhood  String?
  lat           Float?
  lng           Float?
  featured      Boolean       @default(false)
  images        PropertyImage[]
  contacts      Contact[]
  amenities     Amenity[]     @relation("PropertyAmenities")
  // events: log de vistas (VIEW) y clics a WhatsApp (CONTACT_CLICK) de la ficha
  // pública. Agregado 28/07/2026 para las métricas del dashboard admin.
  events        PropertyEvent[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// --- Catálogos gestionables desde el admin (Ajustes → Catálogos) ---
// `value` es el identificador estable que se guarda en Property (ej: "SALE"); `label`
// es lo que se muestra (ej: "Venta"). `order` define el orden en los desplegables.

model OperationType {
  id    Int    @id @default(autoincrement())
  value String @unique
  label String
  order Int    @default(0)
}

model PropertyTypeOption {
  id    Int    @id @default(autoincrement())
  value String @unique
  label String
  order Int    @default(0)
}

model Amenity {
  id         Int        @id @default(autoincrement())
  value      String     @unique
  label      String
  icon       String     @default("")
  order      Int        @default(0)
  properties Property[]  @relation("PropertyAmenities")
}

model PropertyImage {
  id         Int      @id @default(autoincrement())
  url        String
  // "image" | "video": distingue fotos de videos (ambos se suben a Cloudinary y se
  // guardan en esta misma tabla). Default "image" para no romper los registros ya
  // existentes. La ficha usa esto para renderizar <img> o <video> según corresponda.
  type       String   @default("image")
  isPrimary  Boolean  @default(false)
  order      Int      @default(0)
  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Contact {
  id         Int      @id @default(autoincrement())
  name       String
  email      String
  phone      String?
  message    String
  propertyId Int?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
}

// Log de eventos de la ficha pública de una propiedad: una fila por vista (VIEW) y
// por clic en "Consultar por WhatsApp" (CONTACT_CLICK, tanto el botón rápido como el
// submit del formulario). Con fecha (no un contador acumulado) para poder filtrar
// por período en el dashboard admin (ej. "últimos 30 días"). Agregado 28/07/2026.
model PropertyEvent {
  id         Int      @id @default(autoincrement())
  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  type       String   // "VIEW" | "CONTACT_CLICK"
  createdAt  DateTime @default(now())

  @@index([propertyId, type, createdAt])
}

// Postulaciones laborales enviadas desde la página pública /postulaciones (10/08/2026).
// El CV se sube a Cloudinary como `raw` (ver cvUpload.middleware.js) y acá se guarda su
// URL: el mensaje de WhatsApp que se le arma a la inmobiliaria incluye ese link, porque
// los links wa.me solo permiten precargar TEXTO, nunca adjuntar un archivo.
// `read` replica el patrón de Contact para marcar las ya revisadas desde el admin.
model JobApplication {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String
  city      String   @default("")
  position  String   @default("")
  message   String   @default("")
  cvUrl     String
  // cvName: nombre original del archivo subido (ej "cv-juan-perez.pdf"). Se guarda
  // aparte porque la URL de Cloudinary lleva un public_id generado, no el nombre real.
  cvName    String   @default("")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read, createdAt])
}

// Solicitudes de "Abrí una sucursal con nosotros" (bloque inferior de /postulaciones).
// No llevan archivo adjunto: solo datos de contacto + zona de interés. Se guardan además
// de mandarse por WhatsApp para que la inmobiliaria pueda seguir el caso aunque el chat
// se pierda entre conversaciones.
model BranchInquiry {
  id         Int      @id @default(autoincrement())
  name       String
  email      String
  phone      String
  city       String
  experience String   @default("")
  message    String   @default("")
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([read, createdAt])
}

model SiteSettings {
  id            Int    @id @default(autoincrement())
  siteName      String @default("Inmobiliaria Manhattan")
  phone         String @default("")
  whatsapp      String @default("")
  email         String @default("")
  address       String @default("")
  instagram     String @default("")
  facebook      String @default("")
  googleMapsKey String @default("")
  logoUrl       String @default("")
}

// Contenido editable de las páginas públicas (mini-CMS del panel de Ajustes).
// Una fila por página (home, properties, valuations, about, contact, footer);
// `content` guarda un objeto JSON flexible con los campos editables de esa página
// (textos, títulos, URLs de imágenes). El esquema de qué campos tiene cada página
// vive en el frontend (frontend/src/config/siteContent.js), así que agregar o
// quitar campos no requiere migrar la BD: solo se cambia ese esquema.
model PageContent {
  id        Int      @id @default(autoincrement())
  page      String   @unique
  content   Json     @default("{}")
  updatedAt DateTime @updatedAt
}

// enums Operation y PropertyType COMENTADOS (no eliminados, según regla del proyecto):
// se reemplazaron por los catálogos gestionables OperationType / PropertyTypeOption
// (21/07/2026). Los `value` de esos catálogos replican estos valores por defecto.
// enum Operation {
//   SALE
//   RENT
// }
//
// enum PropertyType {
//   HOUSE
//   APARTMENT
//   OFFICE
//   LOCAL
//   LAND
//   PH
// }

enum PropertyStatus {
  AVAILABLE
  RESERVED
  SOLD
  RENTED
}
